{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "extends": [
    "github>stonal-tech/renovate-config//go-service"
  ],
  "packageRules": [
    {
      "addLabels": [
        "automerge"
      ],
      "automerge": true,
      "automergeStrategy": "squash",
      "automergeType": "pr",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "platformAutomerge": true
    }
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "prConcurrentLimit": 2,
  "prHourlyLimit": 1,
  "timezone": "Europe/Paris"
}